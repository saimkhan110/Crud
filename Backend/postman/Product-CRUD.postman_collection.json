{
  "info": {
    "name": "Product CRUD API",
    "description": "Choose a local PNG/JPG/JPEG file in upload requests. Run Create first, then the requests in order. MongoDB and the API must be running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "imagePath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create Product with Image",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Laptop",
              "type": "text"
            },
            {
              "key": "price",
              "value": "120000",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Student laptop",
              "type": "text"
            },
            {
              "key": "category",
              "value": "Electronics",
              "type": "text"
            },
            {
              "key": "stock",
              "value": "5",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "const product = pm.response.json().product;",
              "pm.collectionVariables.set('productId', product._id);",
              "pm.collectionVariables.set('imagePath', product.image || '');",
              "pm.test('Product has an ID', () => pm.expect(product._id).to.be.a('string'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Products array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Single Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. View Uploaded Image",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/{{imagePath}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Update Details (keep image)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 115000,\n  \"stock\": 8\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "const product = pm.response.json().product;",
              "pm.collectionVariables.set('productId', product._id);",
              "pm.collectionVariables.set('imagePath', product.image || '');",
              "pm.test('Product has an ID', () => pm.expect(product._id).to.be.a('string'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Replace Image (select a new file)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "const product = pm.response.json().product;",
              "pm.collectionVariables.set('productId', product._id);",
              "pm.collectionVariables.set('imagePath', product.image || '');",
              "pm.test('Product has an ID', () => pm.expect(product._id).to.be.a('string'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Delete Product and Image",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Deleted Product Returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Deleted Image Returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/{{imagePath}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Invalid ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/invalid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Invalid Price",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Invalid product\",\"price\":-1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Missing Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\"price\":100}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Reject Non-image (select a .txt file)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Invalid upload",
              "type": "text"
            },
            {
              "key": "price",
              "value": "100",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
